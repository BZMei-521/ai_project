{
  "1": {
    "class_type": "LoadImage",
    "inputs": { "image": "{{START_FRAME_PATH}}" }
  },
  "2": {
    "class_type": "DWPreprocessor",
    "inputs": {
      "image": ["1", 0],
      "detect_hand": "disable",
      "detect_body": "enable",
      "detect_face": "disable",
      "resolution": 640,
      "bbox_detector": "yolox_l.torchscript.pt",
      "pose_estimator": "dw-ll_ucoco_384_bs5.torchscript.pt",
      "scale_stick_for_xinsr_cn": "disable"
    }
  },
  "3": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["2", 0],
      "filename_prefix": "FLF2V/pose_extract_candidate_{{CANDIDATE_PADDED}}"
    }
  }
}
