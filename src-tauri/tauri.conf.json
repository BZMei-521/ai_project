{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Storyboard Pro",
  "version": "0.1.0",
  "identifier": "com.duole.storyboardpro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Storyboard Pro",
        "width": 1440,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "resources": {
      "../scripts/evaluators/siglip2-character-attestor.py": "scripts/evaluators/siglip2-character-attestor.py",
      "../scripts/evaluators/siglip2-character-worker.py": "scripts/evaluators/siglip2-character-worker.py",
      "../scripts/prepare-character-reference.py": "scripts/prepare-character-reference.py",
      "../examples/character-consistency-benchmark/benchmark.json": "examples/character-consistency-benchmark/benchmark.json",
      "../examples/character-consistency-benchmark/siglip2-evaluator.example.json": "examples/character-consistency-benchmark/siglip2-evaluator.example.json",
      "../examples/character-consistency-benchmark/siglip2-snapshot-manifest.json": "examples/character-consistency-benchmark/siglip2-snapshot-manifest.json"
    }
  }
}
